rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGiftService(weddingId) {
      return request.auth != null
        && request.auth.token.get('giftServiceFor', '') == weddingId
        && exists(/databases/$(database)/documents/weddings/$(weddingId)/services/gifts)
        && get(/databases/$(database)/documents/weddings/$(weddingId)/services/gifts).data.enabled == true;
    }
    function isWeddingAdmin(weddingId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/weddings/$(weddingId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/weddings/$(weddingId)/members/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/weddings/$(weddingId)/members/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }
    function acceptsRsvp(weddingId) {
      return exists(/databases/$(database)/documents/weddings/$(weddingId))
        && get(/databases/$(database)/documents/weddings/$(weddingId)).data.active == true;
    }
    function validRsvp() {
      return request.resource.data.keys().hasAll(['name', 'attendance', 'guests', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'attendance', 'guests', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.name.matches('.*[^\\s].*')
        && request.resource.data.attendance in ['yes', 'no']
        && request.resource.data.guests is int
        && ((request.resource.data.attendance == 'no' && request.resource.data.guests == 0)
          || (request.resource.data.attendance == 'yes' && request.resource.data.guests >= 1 && request.resource.data.guests <= 10))
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time;
    }
    match /weddings/{weddingId} {
      // Somente metadados públicos do evento; informações de membros ficam na subcoleção.
      allow get: if resource.data.active == true || isWeddingAdmin(weddingId) || isGiftService(weddingId);
      allow list, create, update, delete: if false;
      match /members/{uid} {
        allow get: if (request.auth != null && request.auth.uid == uid) || isGiftService(weddingId);
        allow list, create, update, delete: if false;
      }
      match /gifts/{giftId} { allow read, write: if isGiftService(weddingId); }
      match /gift_reservations/{reservationId} {
        allow read, delete: if isGiftService(weddingId);
        allow create: if isGiftService(weddingId) && acceptsRsvp(weddingId);
        allow update: if isGiftService(weddingId)
          && (acceptsRsvp(weddingId) || request.resource.data.status in ['cancelled', 'failed']);
      }
      match /gift_rate_limits/{limitId} { allow read, write: if isGiftService(weddingId); }
      match /rsvp_responses/{responseId} {
        allow read: if isWeddingAdmin(weddingId);
        allow create: if acceptsRsvp(weddingId) && validRsvp();
        allow update, delete: if false;
      }
    }
    // Presentes e reservas são acessados apenas pela API, que verifica o membro
    // e executa transações. Não exponha nomes, e-mails ou tokens no SDK cliente.
    // LEGACY_COMPATIBILITY
    // Sem permissões para admins/ ou rsvp_responses/ na raiz.
  }
}
