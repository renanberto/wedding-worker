{
  "name": "casamento-elegance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-wedding \"node --test tests/rules/*.test.js\"",
    "test:e2e": "playwright test",
    "env:check": "node scripts/check-env.js",
    "noivos:add": "node scripts/add-noivo.js",
    "firebase:rules:deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "vite": "^6.0.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
