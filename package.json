{
  "name": "onda-wedding-sites",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @wedding/test --",
    "build": "npm run build --workspace @wedding/test",
    "preview": "npm run preview --workspace @wedding/test --",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-wedding \"node --test tests/rules/*.test.js\"",
    "test:e2e": "playwright test",
    "env:check": "npm run env:check --workspace @wedding/test --",
    "noivos:add": "npm run noivos:add --workspace @wedding/test --",
    "firebase:rules:deploy": "firebase deploy --only firestore:rules",
    "deploy:test": "wrangler pages deploy sites/test/dist --project-name onda-wedding-test --branch main"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "vite": "^6.0.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "workspaces": [
    "sites/*",
    "packages/*"
  ]
}
